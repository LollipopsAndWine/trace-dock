{
  "version": "2.2.0",
  "source": "guiji/packages/guiji_tools/src/guiji_tools/.gitleaks.toml",
  "rules": [
    {
      "id": "openai-api-key",
      "description": "OpenAI API key",
      "regex": "\\bsk-(?:proj-)?[A-Za-z0-9_-]{16,}\\b"
    },
    {
      "id": "anthropic-api-key",
      "description": "Anthropic API key",
      "regex": "\\bsk-ant-[A-Za-z0-9_-]{16,}\\b"
    },
    {
      "id": "aws-access-key-id",
      "description": "AWS access key id",
      "regex": "\\b(?:AKIA|ASIA|AIDA|AGPA|AROA|AIPA|ANPA|ANVA)[0-9A-Z]{16}\\b"
    },
    {
      "id": "google-api-key",
      "description": "Google API key",
      "regex": "\\bAIza[0-9A-Za-z\\-_]{35}\\b"
    },
    {
      "id": "github-token",
      "description": "GitHub token",
      "regex": "\\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})\\b"
    },
    {
      "id": "gitlab-token",
      "description": "GitLab token",
      "regex": "\\bglpat-[A-Za-z0-9\\-_]{20,}\\b"
    },
    {
      "id": "sendgrid-token",
      "description": "SendGrid token",
      "regex": "\\bSG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}\\b"
    },
    {
      "id": "slack-token",
      "description": "Slack token",
      "regex": "\\bxox(?:a|b|p|r|s)-[A-Za-z0-9-]{10,}\\b"
    },
    {
      "id": "stripe-key",
      "description": "Stripe key",
      "regex": "\\b(?:sk|rk|pk)_(?:live|test)_[A-Za-z0-9]{16,}\\b"
    },
    {
      "id": "shopify-token",
      "description": "Shopify token",
      "regex": "\\bshpat_[A-Za-z0-9]{20,}\\b"
    },
    {
      "id": "huggingface-token",
      "description": "Hugging Face token",
      "regex": "\\bhf_[A-Za-z0-9]{20,}\\b"
    },
    {
      "id": "npm-token",
      "description": "NPM token",
      "regex": "\\bnpm_[A-Za-z0-9]{20,}\\b"
    },
    {
      "id": "linear-token",
      "description": "Linear token",
      "regex": "\\blin_api_[A-Za-z0-9]{20,}\\b"
    },
    {
      "id": "generic-key-32",
      "description": "Generic 32-char key",
      "regex": "\\bkey-[0-9A-Za-z]{32}\\b"
    },
    {
      "id": "jwt",
      "description": "JWT token",
      "regex": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9._-]{10,}\\.[A-Za-z0-9._-]{10,}\\b"
    },
    {
      "id": "private-key-block",
      "description": "PEM private key block",
      "regex": "-----BEGIN(?: RSA| EC| OPENSSH)? PRIVATE KEY-----[ \\t]*(?:\\r?\\n|\\\\+n|\\\\+r\\\\+n)(?:[A-Za-z0-9+/=]{16,}(?:\\r?\\n|\\\\+n|\\\\+r\\\\+n))+-----END(?: RSA| EC| OPENSSH)? PRIVATE KEY-----"
    }
  ]
}
